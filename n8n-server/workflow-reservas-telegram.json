    {
      "id": "4878e323-cd02-47dd-89f5-fabb4a455f2a",
      "name": "Analizar Mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map((item) => {\n  const body = item.json.body || item.json || {};\n  const textoOriginal = (body.texto || '').trim();\n  const textoLower = textoOriginal.toLowerCase();\n  const chatId = body.chat_id;\n  const usuario = body.usuario || body.username || 'Cliente';\n  const username = body.username ? `@${body.username}` : String(chatId || 'sin-contacto');\n\n  const hoy = new Date().toISOString().slice(0, 10);\n  const matchFecha = textoOriginal.match(/\\b(\\d{4}-\\d{2}-\\d{2})\\b/);\n  const matchHora = textoOriginal.match(/\\b([01]?\\d|2[0-3]):([0-5]\\d)\\b/);\n  const fecha = matchFecha ? matchFecha[1] : hoy;\n  const hora = matchHora ? `${matchHora[1].padStart(2, '0')}:${matchHora[2]}` : null;\n\n  let intencion = 'consulta';\n  let citaId = null;\n  let servicio = 'Consulta General';\n\n  if (textoLower.includes('cancelar') || textoLower.startsWith('/cancelar')) {\n    intencion = 'cancelar';\n    const matchId = textoOriginal.match(/(?:cancelar|id|#)\\s*:?\\s*(\\d+)/i) || textoOriginal.match(/\\b(\\d+)\\b/);\n    citaId = matchId ? parseInt(matchId[1], 10) : 0;\n  } else if (\n    (hora && (matchFecha || textoLower.includes('reservar') || textoLower.includes('agendar') || textoLower.includes('cita') || textoLower.includes('turno'))) ||\n    textoLower.startsWith('/reservar') ||\n    textoLower.startsWith('reservar ') ||\n    textoLower.startsWith('agendar ')\n  ) {\n    if (hora) {\n      intencion = 'reservar';\n      let resto = textoOriginal\n        .replace(/\\/?(reservar|agendar|quiero|cita|turno|para|el|a las|en)/gi, ' ')\n        .replace(matchFecha ? matchFecha[0] : '', ' ')\n        .replace(matchHora[0], ' ')\n        .replace(/\\s+/g, ' ')\n        .trim();\n      if (resto.length >= 3) {\n        servicio = resto;\n      }\n    } else {\n      intencion = 'disponibilidad';\n    }\n  } else if (\n    textoLower.includes('cita') ||\n    textoLower.includes('reserva') ||\n    textoLower.includes('disponib') ||\n    textoLower.includes('horario') ||\n    textoLower.includes('agenda') ||\n    textoLower.includes('turno') ||\n    Boolean(matchFecha)\n  ) {\n    intencion = 'disponibilidad';\n  }\n\n  return {\n    json: {\n      chat_id: chatId,\n      usuario,\n      cliente_nombre: usuario,\n      cliente_contacto: username,\n      texto: textoOriginal,\n      intencion,\n      fecha,\n      hora,\n      fecha_hora: hora ? `${fecha}T${hora}:00` : null,\n      servicio,\n      cita_id: citaId\n    }\n  };\n});",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
    },
